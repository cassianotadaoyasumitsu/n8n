# We want to include the THIRD_PARTY_LICENSES.md file in the Docker image,
# but not other .md files
**/*.md
!**/THIRD_PARTY_LICENSES.md
!HEROKU_DEPLOYMENT.md
**/.env
**/.env.*
!**/.env.heroku.example
.cache
assets
node_modules
packages/node-dev
packages/**/node_modules
packages/**/dist
packages/**/.turbo
packages/**/*.test.*
.git
.github
!.github/scripts
*.tsbuildinfo
docker/compose
docker/**/Dockerfile
.vscode
packages/testing
cypress
.turbo
build.log
*.log

# Heroku specific
.heroku
Procfile.local
docker-compose*.yml
heroku-deployment-setup.plan.md

# Development files
.editorconfig
.prettierrc
.prettierignore
lefthook.yml
renovate.json
codecov.yml
