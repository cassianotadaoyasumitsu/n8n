# ==============================================================================
# Simplified Heroku Deployment using Official n8n Docker Image
# ==============================================================================
# Instead of building the complex monorepo, we use the official pre-built image
# and just configure it for Heroku's requirements (dynamic PORT)
# ==============================================================================

FROM n8nio/n8n:latest

# Switch to root to make modifications
USER root

# Install bash for our startup script
RUN apk add --no-cache bash

# Create Heroku-compatible startup script
RUN echo '#!/bin/bash' > /usr/local/bin/heroku-entrypoint.sh && \
    echo 'set -e' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo '' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo 'echo "========================================"' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo 'echo "Starting n8n on Heroku..."' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo 'echo "========================================"' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo '' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo '# Heroku compatibility: Use $PORT if set' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo 'if [ -n "$PORT" ]; then' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo '  export N8N_PORT=$PORT' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo '  echo "✓ Using Heroku PORT: $PORT"' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo 'else' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo '  export N8N_PORT=${N8N_PORT:-5678}' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo '  echo "✓ Using default PORT: $N8N_PORT"' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo 'fi' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo '' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo 'echo "Configuration:"' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo 'echo "  N8N_HOST: $N8N_HOST"' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo 'echo "  N8N_PROTOCOL: $N8N_PROTOCOL"' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo 'echo "  N8N_PORT: $N8N_PORT"' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo 'echo "  DB_TYPE: $DB_TYPE"' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo 'echo "  WEBHOOK_URL: $WEBHOOK_URL"' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo 'echo "========================================"' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo '' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo 'echo "Starting n8n application..."' >> /usr/local/bin/heroku-entrypoint.sh && \
    echo 'exec n8n start' >> /usr/local/bin/heroku-entrypoint.sh && \
    chmod +x /usr/local/bin/heroku-entrypoint.sh

# Set environment
ENV NODE_ENV=production

# Expose port (Heroku will override with $PORT)
EXPOSE 5678

# Switch back to node user
USER node

# Use our custom entrypoint
ENTRYPOINT ["tini", "--", "/usr/local/bin/heroku-entrypoint.sh"]
CMD []
