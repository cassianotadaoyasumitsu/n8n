FROM node:22.18.0-alpine AS builder

# Install dependencies
RUN apk add --update --no-cache \
    python3 \
    py3-pip \
    build-base \
    ca-certificates \
    git \
    bash \
    openssh \
    curl

# Install pnpm
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.18.3 --activate

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY scripts ./scripts

# Copy all package.json files to install dependencies
COPY packages ./packages

# Install dependencies
RUN pnpm install --frozen-lockfile --prod=false

# Copy source code
COPY . .

# Build the application
RUN pnpm build

# Production stage
FROM node:22.18.0-alpine AS production

# Install runtime dependencies
RUN apk add --update --no-cache \
    ca-certificates \
    bash \
    tzdata \
    tini \
    su-exec \
    ffmpeg \
    && rm -rf /var/cache/apk/*

# Set timezone
ENV TZ=America/Sao_Paulo
ENV NODE_ENV=production
ENV NODE_ICU_DATA=/usr/local/lib/node_modules/full-icu

# Create n8n user
RUN addgroup -g 1000 node && \
    adduser -u 1000 -G node -s /bin/sh -D node

WORKDIR /home/node

# Copy built application from builder
COPY --from=builder --chown=node:node /app/packages/cli/dist /usr/local/lib/node_modules/n8n/dist
COPY --from=builder --chown=node:node /app/packages/cli/bin /usr/local/lib/node_modules/n8n/bin
COPY --from=builder --chown=node:node /app/packages/cli/package.json /usr/local/lib/node_modules/n8n/
COPY --from=builder --chown=node:node /app/packages/cli/templates /usr/local/lib/node_modules/n8n/templates
COPY --from=builder --chown=node:node /app/packages/cli/node_modules /usr/local/lib/node_modules/n8n/node_modules

# Copy other necessary packages
COPY --from=builder --chown=node:node /app/packages/core /usr/local/lib/node_modules/n8n/node_modules/n8n-core
COPY --from=builder --chown=node:node /app/packages/workflow /usr/local/lib/node_modules/n8n/node_modules/n8n-workflow
COPY --from=builder --chown=node:node /app/packages/nodes-base /usr/local/lib/node_modules/n8n/node_modules/n8n-nodes-base
COPY --from=builder --chown=node:node /app/packages/frontend/editor-ui/dist /usr/local/lib/node_modules/n8n/node_modules/n8n-editor-ui/dist

# Create symlink
RUN ln -s /usr/local/lib/node_modules/n8n/bin/n8n /usr/local/bin/n8n && \
    mkdir -p /home/node/.n8n && \
    chown -R node:node /home/node

# Heroku compatibility: Handle dynamic PORT
RUN echo '#!/bin/sh' > /usr/local/bin/docker-entrypoint.sh && \
    echo 'set -e' >> /usr/local/bin/docker-entrypoint.sh && \
    echo '' >> /usr/local/bin/docker-entrypoint.sh && \
    echo '# Heroku compatibility: Use $PORT if set' >> /usr/local/bin/docker-entrypoint.sh && \
    echo 'if [ -n "$PORT" ]; then' >> /usr/local/bin/docker-entrypoint.sh && \
    echo '  export N8N_PORT=$PORT' >> /usr/local/bin/docker-entrypoint.sh && \
    echo '  echo "Using Heroku PORT: $PORT"' >> /usr/local/bin/docker-entrypoint.sh && \
    echo 'fi' >> /usr/local/bin/docker-entrypoint.sh && \
    echo '' >> /usr/local/bin/docker-entrypoint.sh && \
    echo 'if [ "$#" -gt 0 ]; then' >> /usr/local/bin/docker-entrypoint.sh && \
    echo '  exec n8n "$@"' >> /usr/local/bin/docker-entrypoint.sh && \
    echo 'else' >> /usr/local/bin/docker-entrypoint.sh && \
    echo '  exec n8n' >> /usr/local/bin/docker-entrypoint.sh && \
    echo 'fi' >> /usr/local/bin/docker-entrypoint.sh && \
    chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 5678

USER node

ENTRYPOINT ["tini", "--", "/usr/local/bin/docker-entrypoint.sh"]
CMD []

