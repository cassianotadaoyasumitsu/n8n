# ==============================================================================
# n8n Environment Variables for Heroku Deployment
# ==============================================================================
# Copy this file and set these variables in Heroku using:
# heroku config:set VARIABLE_NAME=value --app your-app-name
#
# Or use the Heroku Dashboard: Settings > Config Vars
# ==============================================================================

# ------------------------------------------------------------------------------
# CRITICAL: Set these before first deployment
# ------------------------------------------------------------------------------

# Generate a secure random key (32+ characters). This encrypts credentials in the database.
# NEVER change this after initial deployment - it will break existing credentials!
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_STRING

# Your Heroku app URL (replace 'your-app-name' with your actual Heroku app name)
N8N_HOST=your-app-name.herokuapp.com
WEBHOOK_URL=https://your-app-name.herokuapp.com/

# ------------------------------------------------------------------------------
# Protocol & Network Configuration
# ------------------------------------------------------------------------------

# Use HTTPS on Heroku
N8N_PROTOCOL=https

# Heroku assigns PORT dynamically - do NOT set N8N_PORT manually
# The docker-entrypoint.sh automatically handles Heroku's $PORT variable

# Listen on all interfaces (required for Heroku)
N8N_LISTEN_ADDRESS=0.0.0.0

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------

# Use PostgreSQL (required for Heroku - SQLite doesn't persist)
DB_TYPE=postgresdb

# Heroku Postgres automatically sets DATABASE_URL
# n8n can parse DATABASE_URL automatically, but you can also set these explicitly:
#
# If using DATABASE_URL (recommended - automatically set by Heroku Postgres addon):
# Leave these commented out and n8n will parse DATABASE_URL
#
# If setting manually (extract from DATABASE_URL):
# DB_POSTGRESDB_DATABASE=your_database_name
# DB_POSTGRESDB_HOST=your_postgres_host.amazonaws.com
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_USER=your_postgres_user
# DB_POSTGRESDB_PASSWORD=your_postgres_password
# DB_POSTGRESDB_SSL_ENABLED=true
# DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

# ------------------------------------------------------------------------------
# Environment
# ------------------------------------------------------------------------------

NODE_ENV=production

# ------------------------------------------------------------------------------
# Optional: Feature Configuration
# ------------------------------------------------------------------------------

# Disable version notifications (optional)
# N8N_VERSION_NOTIFICATIONS_ENABLED=false

# Disable diagnostics/telemetry (optional)
# N8N_DIAGNOSTICS_ENABLED=false

# Set timezone (optional)
# GENERIC_TIMEZONE=America/New_York

# Enable/disable user management features
# N8N_USER_MANAGEMENT_DISABLED=false

# ------------------------------------------------------------------------------
# Optional: Email Configuration (for user invites, password resets)
# ------------------------------------------------------------------------------

# N8N_EMAIL_MODE=smtp
# N8N_SMTP_HOST=smtp.gmail.com
# N8N_SMTP_PORT=465
# N8N_SMTP_USER=your-email@gmail.com
# N8N_SMTP_PASS=your-app-password
# N8N_SMTP_SENDER=your-email@gmail.com
# N8N_SMTP_SSL=true

# ------------------------------------------------------------------------------
# Optional: Authentication Configuration
# ------------------------------------------------------------------------------

# Disable authentication (NOT RECOMMENDED for production)
# N8N_BASIC_AUTH_ACTIVE=false

# JWT configuration (optional - defaults are usually fine)
# N8N_JWT_AUTH_HEADER=authorization
# N8N_JWT_HEADER_SIGNED_TOKEN=Bearer

# ------------------------------------------------------------------------------
# Optional: Workflow Execution Configuration
# ------------------------------------------------------------------------------

# Maximum execution timeout (in seconds)
# EXECUTIONS_TIMEOUT=300

# Save execution data
# EXECUTIONS_DATA_SAVE_ON_ERROR=all
# EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
# EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# Maximum number of execution data entries to keep
# EXECUTIONS_DATA_MAX_AGE=168  # In hours (168 = 7 days)

# ------------------------------------------------------------------------------
# Optional: Queue Mode (for scaling with multiple dynos)
# ------------------------------------------------------------------------------
# Note: Requires Redis addon for queue mode
# QUEUE_BULL_REDIS_HOST=your-redis-host
# QUEUE_BULL_REDIS_PORT=6379
# QUEUE_BULL_REDIS_PASSWORD=your-redis-password
# EXECUTIONS_MODE=queue

# ------------------------------------------------------------------------------
# Optional: External Storage (for large files)
# ------------------------------------------------------------------------------
# Note: Heroku has ephemeral filesystem. For file persistence, use S3/GCS
# N8N_DEFAULT_BINARY_DATA_MODE=filesystem
# N8N_BINARY_DATA_STORAGE_PATH=/home/node/.n8n/binaryData

# For S3 (if needed in future):
# N8N_DEFAULT_BINARY_DATA_MODE=s3
# N8N_BINARY_DATA_S3_BUCKET=your-bucket-name
# N8N_BINARY_DATA_S3_REGION=us-east-1
# N8N_BINARY_DATA_S3_ACCESS_KEY_ID=your-access-key
# N8N_BINARY_DATA_S3_ACCESS_SECRET=your-secret-key

# ------------------------------------------------------------------------------
# Optional: Logging
# ------------------------------------------------------------------------------

# Log level (options: info, debug, warn, error)
# N8N_LOG_LEVEL=info

# Log output format
# N8N_LOG_OUTPUT=console

# ------------------------------------------------------------------------------
# Security Headers
# ------------------------------------------------------------------------------

# N8N_SECURE_COOKIE=true

